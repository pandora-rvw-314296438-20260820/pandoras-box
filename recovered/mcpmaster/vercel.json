{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "PANDORA_MEMORY_BASE_URL": "https://pandorasbox-memory.vercel.app",
    "PANDORA_MCP_RESOURCE_ORIGIN": "https://mcpmaster.vercel.app"
  },
  "functions": {
    "api/oauth-consent.ts": {
      "includeFiles": "public/oauth/**",
      "maxDuration": 10
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "pandoras-box-system.vercel.app"}],
      "destination": "https://mcpmaster.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "mcpmaster-hazel.vercel.app"}],
      "destination": "https://mcpmaster.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "mcpmaster-mbanatao-dc676069.vercel.app"}],
      "destination": "https://mcpmaster.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"},
        {"key": "X-DNS-Prefetch-Control", "value": "off"}
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/mcp",
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/health",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/oauth/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/.well-known/:path*",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"}]
    },
    {
      "source": "/control-tower/:path*",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"}]
    },
    {
      "source": "/",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    }
  ],
  "rewrites": [
    {"source": "/health", "destination": "/api/health"},
    {"source": "/mcp", "destination": "/api/mcp"},
    {"source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp?metadata=root"},
    {"source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/mcp?metadata=mcp"},
    {"source": "/oauth/consent", "destination": "/api/oauth-consent?asset=html"},
    {"source": "/oauth/consent.js", "destination": "/api/oauth-consent?asset=js"},
    {"source": "/api/operator/:path*", "destination": "/api/operator"}
  ]
}
