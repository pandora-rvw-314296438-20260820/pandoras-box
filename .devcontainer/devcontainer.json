
{
  "name": "Pandora Exact APK Builder",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "remoteUser": "root",
  "forwardPorts": [9114],
  "portsAttributes": {
    "9114": {
      "label": "Pandora APK",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  }
}
