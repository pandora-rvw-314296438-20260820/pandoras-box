{
    "name": "Pandora Exact Local AI APK Builder",
    "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
    "remoteUser": "codespace",
    "containerEnv": {
        "PANDORA_BUILDER_REV": "5"
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "postCreateCommand": "echo PANDORA_BUILDER_REV_5 && bash .devcontainer/build-picker-apk.sh"
}