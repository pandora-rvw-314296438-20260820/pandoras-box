<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.banataosystems.pandora.uicapture">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <application android:label="Pandora CI UI capture" android:allowBackup="false"
        android:debuggable="false" android:hasCode="true" />
    <!-- Self-targeting keeps instrumentation from restarting the PLP process. -->
    <instrumentation android:name=".CaptureInstrumentation"
        android:targetPackage="com.banataosystems.pandora.uicapture"
        android:functionalTest="true" />
</manifest>
