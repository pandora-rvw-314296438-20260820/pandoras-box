<?xml version="1.0" encoding="utf-8"?>
<!--
  Deterministic Porcelain window underlay.

  The generated Flutter template uses "?android:colorBackground", which
  resolves to the platform default and appears black in dark mode wherever the
  Flutter surface is translucent. Pandora pins the window background to its own
  canvas instead, so the window, the splash, and the Flutter canvas are the same
  colour across cold start, warm start, and resume.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/pandora_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
