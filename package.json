{
  "name": "mcpmaster",
  "version": "1.3.0-observability",
  "private": true,
  "description": "Pandoras-Box control plane with the MCPMaster secure provider gateway runtime",
  "main": "vercel-entrypoint.js",
  "workspaces": [
    "apps/meta-business-mcp",
    "packages/shared-security"
  ],
  "scripts": {
    "build:runtime": "tsc -p tsconfig.json",
    "build:shared-security": "tsc -p packages/shared-security/tsconfig.json",
    "build:meta": "tsc -p apps/meta-business-mcp/tsconfig.json",
    "build": "npm run build:shared-security && npm run build:meta && npm run build:runtime",
    "vercel-build": "npm run build",
    "check:browser": "node scripts/check-browser-syntax.mjs",
    "check:mirrors": "node scripts/verify-frontend-mirrors.mjs",
    "check:supabase": "node scripts/check-supabase-syntax.mjs",
    "check:supabase:types": "npx --yes deno-bin@2.2.7 check --node-modules-dir=none --frozen supabase/functions/pandora-owner-api/index.ts supabase/functions/pandora-worker-dispatch/index.ts supabase/functions/pandora-reviewer-attestation/index.ts supabase/functions/pandora-release-review-attestation/index.ts supabase/functions/pandora-release-owner-authorization/index.ts supabase/functions/pandora-physical-android-attestation/index.ts supabase/functions/mcpmaster-supabase-control/index.ts",
    "check:supabase:replay": "node scripts/replay-supabase-migrations.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p packages/shared-security/tsconfig.json --noEmit && tsc -p apps/meta-business-mcp/tsconfig.json --noEmit && tsc -p tsconfig.vercel.json && npm run check:browser && npm run check:mirrors && npm run check:supabase && npm run check:supabase:types && npm run check:supabase:replay",
    "test": "npm run build && node --test test/*.test.js apps/meta-business-mcp/test/*.test.js packages/shared-security/test/*.test.js && npm run test:worker",
    "test:worker": "node --test workers/windows/test/*.test.mjs",
    "test:coverage": "npm run build && NODE_V8_COVERAGE=coverage node --test test/*.test.js apps/meta-business-mcp/test/*.test.js packages/shared-security/test/*.test.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "start": "node dist/http-server.js",
    "dev": "node src/http-server.js",
    "start:mcp": "node dist/mcp-stdio.js",
    "dev:mcp": "node src/mcp-stdio.js",
    "start:meta-remote": "node apps/meta-business-mcp/dist/remote-server.js",
    "dev:meta-remote": "npm run build:runtime --silent && node apps/meta-business-mcp/src/remote-server.js",
    "meta:staging:validate": "npm run build:meta && node apps/meta-business-mcp/dist/staging-cli.js validate",
    "meta:staging:prove-access": "npm run build:meta && node apps/meta-business-mcp/dist/staging-cli.js prove-access",
    "meta:staging:smoke": "npm run build:meta && node apps/meta-business-mcp/dist/staging-cli.js smoke",
    "aws-deploy": "aws/deploy.sh",
    "aws-deploy-win": "powershell -ExecutionPolicy Bypass -File aws/deploy.ps1",
    "aws-deploy-complete": "aws/deploy-complete.sh",
    "aws-deploy-complete-win": "powershell -ExecutionPolicy Bypass -File aws/deploy-complete.ps1",
    "aws-setup": "aws/setup-aws.sh",
    "aws-setup-win": "powershell -ExecutionPolicy Bypass -File aws/setup-aws.ps1",
    "docker-build": "docker build -t mcpmaster .",
    "docker-run": "docker run -p 3000:3000 --env-file .env mcpmaster"
  },
  "keywords": [
    "pandoras-box",
    "mcp",
    "model-context-protocol",
    "ai-operations",
    "approval-gates",
    "audit",
    "github",
    "supabase",
    "flutterflow",
    "banatao-systems"
  ],
  "author": "Banatao Systems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandora-rvw-314296438-20260820/pandoras-box.git"
  },
  "bugs": {
    "url": "https://github.com/pandora-rvw-314296438-20260820/pandoras-box/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/oidc": "^3.8.4",
    "express": "^5.2.1",
    "cors": "^2.8.6",
    "helmet": "^8.1.0",
    "zod": "^4.4.3",
    "node-fetch": "^3.3.2",
    "ws": "^8.21.1",
    "three": "^0.158.0",
    "telegraf": "^4.15.0",
    "@slack/web-api": "^8.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/ws": "^8.5.10",
    "@types/three": "^0.158.3",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "@vercel/node": "5.10.2"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "fast-uri": "4.1.2",
    "hono": "4.13.0",
    "undici": "6.28.0",
    "path-to-regexp": "6.3.0",
    "diff": "4.0.4"
  }
}
