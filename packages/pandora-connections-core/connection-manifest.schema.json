{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandora.invalid/contracts/connection-manifest-v1.schema.json",
  "title": "Pandora Connection Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerKey",
    "manifestVersion",
    "displayName",
    "auth",
    "scopes",
    "callback",
    "accountIdentity",
    "health",
    "credential",
    "dataResidency",
    "riskClass",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "providerKey": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "riskClass": { "enum": ["low", "medium", "high", "regulated"] },
    "auth": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["oauth2", "oidc", "api_key", "service_credential", "workload_identity", "device_pairing", "partner_activation"] },
        "pkce": {
          "type": "object",
          "required": ["required", "method"],
          "properties": { "required": { "const": true }, "method": { "const": "S256" } }
        },
        "state": {
          "type": "object",
          "required": ["required", "ttlSeconds"],
          "properties": { "required": { "const": true }, "ttlSeconds": { "type": "integer", "minimum": 60, "maximum": 900 } }
        },
        "nonce": {
          "type": "object",
          "required": ["required"],
          "properties": { "required": { "const": true } }
        }
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "read", "write"],
      "properties": {
        "strategy": { "const": "read_first" },
        "read": { "$ref": "#/$defs/scopes" },
        "write": { "$ref": "#/$defs/scopesAllowEmpty" }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webPath", "mobile"],
      "properties": {
        "webPath": { "type": "string", "pattern": "^/" },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secureBrowser", "returnModes"],
          "properties": {
            "secureBrowser": { "const": "custom_tab" },
            "returnModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": { "enum": ["app_link", "universal_link"] },
              "items": { "enum": ["app_link", "universal_link"] }
            }
          }
        }
      }
    },
    "accountIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableSubjectFields", "displayFields", "tenantSelector"],
      "properties": {
        "stableSubjectFields": { "$ref": "#/$defs/nonEmptyStrings" },
        "displayFields": { "$ref": "#/$defs/nonEmptyStrings" },
        "tenantSelector": { "type": "boolean" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safeReadCapability", "maxAgeSeconds", "identityReadback", "scopesReadback"],
      "properties": {
        "safeReadCapability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "maxAgeSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
        "identityReadback": { "const": true },
        "scopesReadback": { "const": true }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "clientExposure", "rotateSupported", "revokeSupported"],
      "properties": {
        "storage": { "const": "server_vault_reference" },
        "clientExposure": { "const": "forbidden" },
        "rotateSupported": { "type": "boolean" },
        "revokeSupported": { "type": "boolean" }
      }
    },
    "dataResidency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement", "allowedPolicies"],
      "properties": {
        "enforcement": { "const": "tenant_policy" },
        "allowedPolicies": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityKey", "operationMode", "requiredScopes", "evidenceModes"],
        "properties": {
          "capabilityKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "operationMode": { "enum": ["read", "write"] },
          "requiredScopes": { "$ref": "#/$defs/scopes" },
          "evidenceModes": { "$ref": "#/$defs/nonEmptyStrings" },
          "requiresStepUp": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "operationMode": { "const": "write" } }, "required": ["operationMode"] },
            "then": { "required": ["requiresStepUp"], "properties": { "requiresStepUp": { "const": true } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "auth": { "properties": { "type": { "enum": ["oauth2", "oidc"] } }, "required": ["type"] } } },
      "then": { "properties": { "auth": { "required": ["pkce", "state", "nonce"] } } }
    }
  ],
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$" }
    },
    "scopesAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$" }
    }
  }
}
