{
  "schemaVersion": "pandora-protected-app-security-v1",
  "status": "implemented-contract-physical-acceptance-pending",
  "productionBaseline": {
    "stockFirmware": true,
    "lockedBootloader": true,
    "rootAllowed": false,
    "customRomAllowed": false,
    "verifiedBootTrusted": true,
    "preserveGoogleSystemServices": true,
    "preserveBiometrics": true,
    "preserveSimTelephony": true,
    "preserveImsDependencies": true,
    "physicalVerificationRequired": true
  },
  "protectedClasses": ["financial", "authenticator", "password_manager", "identity_security", "security_sensitive"],
  "allowedHandoffs": ["launch", "open_supported_deep_link", "show_instructions"],
  "forbidden": ["credential_extract", "credential_scrape", "otp_read", "otp_bypass", "authenticator_secret_export", "biometric_bypass", "device_integrity_bypass", "protected_screen_scrape", "silent_financial_transfer"],
  "standingAuthorityRequires": ["scope_match", "bounds_verified"],
  "financialRiskTiers": {
    "F0": "information_only",
    "F1": "protected_app_handoff",
    "F2": "account_or_payee_change",
    "F3": "money_movement_or_purchase",
    "F4": "security_bypass_forbidden"
  },
  "destructiveProvisioningRequires": [
    "authenticator_recovery_verified",
    "password_manager_recovery_verified",
    "protected_app_recovery_verified",
    "backup_export_verified",
    "sim_esim_recovery_verified",
    "known_good_rollback_available",
    "explicit_destructive_authority"
  ],
  "auditRequiredFields": [
    "actor", "authority_basis", "job_action_identity", "capability_operation",
    "redacted_input_scope", "idempotency_key_hash", "outcome",
    "verification_state", "provider_readback", "evidence_ids", "timestamps"
  ],
  "acceptanceBoundary": "CI proves policy behavior only. Redmi, GCash/bank/authenticator, telephony, IMS/VoLTE, mobile-data and HyperOS acceptance require the final exact-source physical APK run."
}
